{
 "mass_rows": "f = R * M * b^E * D; R in allowed refs (section 4.2, 8.1); classes A-D",
 "dimless_rows": "R = 1; classes A-E",
 "angle_rows": "classes A-C, transform T in {sin, sin2, tan, frac360, rad}, optional additive (s p/q) theta_ref",
 "exponent_forms": {
  "int": "N",
  "offset": "N + s*b^-k, k in {1,2,3}",
  "self": "s*b (no N)"
 },
 "classes": {
  "A": "M=1,D=1",
  "B": "M=(p/q)sqrt(s), s=1: p<=2048,q<=12; s in {2,3,5}: p,q<=12; coprime; M!=1",
  "C": "D=1+c1*alpha, c1=s p/q, 1<=p<=36, 1<=q<=10, coprime",
  "D": "D=1+c1*alpha+c2*b^j*alpha^2, c1 in +-1..20, c2 in +-{1,2,3,5,1/2,1/3,1/5}, j in -20..20, |D-1|<=0.5",
  "E": "dimless only: M integer 2..512, D=1+s/K, K 1..512, D>0"
 },
 "costs": {
  "class": "log2 5",
  "R": "log2 |allowed refs| (0 if 1)",
  "exponent": "log2 3 + [int: 1+delta(|N|+1)] [offset: +1+log2 3] [self: +1]",
  "M": "delta(p)+delta(q)+2",
  "c1,c2": "1+delta(p)+delta(q)",
  "j": "1+delta(|j|+1)",
  "K": "1+delta(K)",
  "angle": "log2 5 + 1 flag; additive: 1+delta(p)+delta(q)+1"
 },
 "additive": {
  "p_max": 36,
  "q_max": 10,
  "refs": [
   "theta13",
   "theta_C"
  ],
  "banned": {
   "s12": "theta_C",
   "th13": "theta13"
  }
 },
 "N": {
  "solve": "N* = round(x); evaluate N*-1, N*, N*+1",
  "N_max": "ceil(ln(1e25)/ln b)"
 },
 "alpha_dressing": 0.0072973525643314245
}